  "Age > 18"  = "Age > 18", "Age > 45" = "Age > 45", "Age > 65" = "Age > 65",
  "Male"      = "Males Only", "Female" = "Females Only", "Both" = "Both Sexes",
  "Death: Excluded"     = "Exclude early deaths (<=3yr)",
  "Death: Not Excluded" = "Include all deaths",
  "CRP: Excluded"       = "Exclude high CRP (<=10 mg/L)",
  "CRP: Not Excluded"   = "Include all CRP values",
  "---GAP_DEMOG_EXCL---" = " ", "---GAP_EXCL_COV---" = "  "
)

control_inclusions_df <- plot_specs_df %>%
  select(spec_id, controls) %>%
  mutate(controls = ifelse(is.na(controls) | controls == "", "NO_CONTROL", controls)) %>%
  mutate(var = str_split(controls, "\\s*\\+\\s*")) %>%
  unnest(var) %>%
  filter(var != "NO_CONTROL") %>%
  select(spec_id, var)

subset_inclusions_df <- plot_specs_df %>%
  select(-controls) %>%
  pivot_longer(cols = -spec_id, names_to = "filter_type", values_to = "var") %>%
  select(spec_id, var)

master_inclusions_df <- bind_rows(
  control_inclusions_df,
  subset_inclusions_df
) %>%
  distinct() %>%
  mutate(included = TRUE)

estimates_df <- res_df %>%
  filter(!is.na(estimate)) %>%
  transmute(
    spec_id,
    estimate_HR  = exp(estimate),
    conf.low_HR  = exp(conf.low),
    conf.high_HR = exp(conf.high)
  ) %>%
  arrange(estimate_HR) %>%
  mutate(
    is_significant = (conf.low_HR > 1 | conf.high_HR < 1),
    spec_order     = factor(spec_id, levels = spec_id)
  )

spec_grid_final <- expand_grid(spec_id = estimates_df$spec_id, var = all_vars_to_plot) %>%
  left_join(master_inclusions_df, by = c("spec_id", "var")) %>%
  mutate(included = if_else(is.na(included), FALSE, included)) %>%
  left_join(estimates_df %>% select(spec_id, spec_order), by = "spec_id") %>%
  mutate(
    var_label = var_labels[var],
    var_label = factor(var_label, levels = rev(var_labels[all_vars_to_plot]))
  ) %>%
  filter(!is.na(spec_order) & !is.na(var_label))

primary_color      <- col_nonsignif
significance_color <- col_signif
secondary_color    <- col_ci

#####plot curve#####

p_est <- ggplot(estimates_df, aes(x = spec_order, y = estimate_HR)) +
  geom_hline(yintercept = 1, linetype = "dashed", color = "black") +
  geom_errorbar(aes(ymin = conf.low_HR, ymax = conf.high_HR),
                width = 0, size = 0.3, color = secondary_color) +
  geom_point(aes(color = is_significant), size = 1.2) +
  scale_color_manual(
    values = c("TRUE" = significance_color, "FALSE" = primary_color),
    guide  = "none"
  ) +
  theme_bw(base_size = 12, base_family = "sans") +
  labs(x = NULL, y = NULL) +
  coord_cartesian(ylim = c(0.8, 1.5)) +
  theme(
    axis.text.x  = element_blank(),
    axis.ticks.x = element_blank()
  )

p_grid <- ggplot(spec_grid_final, aes(x = spec_order, y = var_label)) +
  geom_tile(fill = "white") +
  geom_point(data = filter(spec_grid_final, included == TRUE),
             shape = "|", size = 2, color = "black") +
  theme_bw(base_size = 12, base_family = "sans") +
  labs(x = NULL, y = NULL) +
  theme(
    panel.grid      = element_blank(),
    axis.text.x     = element_blank(),
    axis.ticks.x    = element_blank(),
    legend.position = "none"
  )

final_plot <- p_est / p_grid +
  plot_layout(heights = c(1, 2)) +
  plot_annotation(
    title   = NULL,
    caption = NULL,
    theme = theme(
      plot.title   = element_text(color = "black", family = "sans"),
      plot.caption = element_text(color = "black", family = "sans")
    )
  )

print(final_plot)
