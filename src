coxph_robust <- function(formula, data, ...) {
  purrr::possibly(
    .f = function(f, d) {
      survival::coxph(
        formula = as.formula(paste0(f, " + RIDRETH1 + SMQHE + BMXBMI + RIDAGEYR")),
        data = d
      )
    },
    otherwise = NULL
  )(formula, data)
}

