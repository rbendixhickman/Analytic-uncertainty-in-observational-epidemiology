extract_hr <- function(m, label, group) {
  cf <- summary(m)$coefficients
  ci <- exp(confint(m))
  data.frame(
    label   = label,
    group   = group,
    n       = m$n,
    events  = m$nevent,
    HR      = exp(cf["CRPNATLOG", "coef"]),
    CI_low  = ci["CRPNATLOG", 1],
    CI_high = ci["CRPNATLOG", 2],
    p_value = cf["CRPNATLOG", "Pr(>|z|)"]
  )
}

